{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JYSHarness",
  "version": "0.2.0",
  "identifier": "dev.jysharness.app",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "windows": [
      {
        "title": "JYSHarness",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "url": "http://127.0.0.1:4317/",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}